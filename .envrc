# .envrc — sekrety marmaapps-static pobierane z pass (https://www.passwordstore.org/).
# Aktywacja: direnv allow
# Tylko odwołania do pass; nigdy wartości (zob. CLAUDE.md).
# Wpisy odkomentuj po utworzeniu ich w pass (projekt Supabase powstaje w U8).

# Import danych (U5): bezpośrednie połączenie z Postgres projektu Supabase.
# export SUPABASE_DB_URL="$(pass projects/marmaapps-static/SUPABASE_DB_URL)"

# Ustawianie sekretów funkcji Edge (U8): `supabase secrets set`.
# export SUPABASE_ACCESS_TOKEN="$(pass projects/marmaapps-static/SUPABASE_ACCESS_TOKEN)"
# export OPENAI_API_KEY="$(pass projects/marmaapps-static/OPENAI_API_KEY)"
