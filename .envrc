# .envrc — sekrety marmaapps-static pobierane z pass (https://www.passwordstore.org/).
# Aktywacja: direnv allow
# Tylko odwołania do pass; nigdy wartości (zob. CLAUDE.md).
# Wpis odkomentuj dopiero po utworzeniu go w pass (`pass insert projects/marmaapps-static/<NAZWA>`),
# inaczej direnv zgłosi błąd.
#
# Celowo bez SUPABASE_SECRET_KEY: żaden skrypt go nie używa (funkcja search działa z JWT
# użytkownika, import używa SUPABASE_DB_URL). Klucz jest tylko w pass jako kopia.
# URL i klucz publishable to konfiguracja publiczna: `.env.local` (VITE_*) i repository variables.

# Wdrożenie lokalne i sekrety funkcji Edge: `supabase link`, `supabase db push`,
# `supabase secrets set` (docs/supabase-setup.md, sekcja 7).
export SUPABASE_PROJECT_REF="$(pass projects/marmaapps-static/SUPABASE_PROJECT_REF)"
export SUPABASE_DB_PASSWORD="$(pass projects/marmaapps-static/SUPABASE_DB_PASSWORD)"
# export SUPABASE_ACCESS_TOKEN="$(pass projects/marmaapps-static/SUPABASE_ACCESS_TOKEN)"
# export OPENAI_API_KEY="$(pass projects/marmaapps-static/OPENAI_API_KEY)"

# Import danych (U5): bezpośrednie połączenie z Postgres projektu Supabase.
# Odkomentuj tylko na czas importu.
# export SUPABASE_DB_URL="$(pass projects/marmaapps-static/SUPABASE_DB_URL)"

# Test regresji E2E (ręcznie, e2e/README.md). Adres konta testowego z listy dozwolonych.
# export E2E_EMAIL="$(pass projects/marmaapps-static/E2E_EMAIL)"
