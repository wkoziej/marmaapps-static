# Publiczna konfiguracja strony (Vite wstawia ją do kodu przy budowaniu).
# Skopiuj do `.env.local` i uzupełnij. Nie wpisuj tu klucza secret / service_role.
#
# Adres projektu Supabase, np. http://127.0.0.1:54321 (lokalny stack: `npx supabase status`).
VITE_SUPABASE_URL=
# Klucz publiczny (publishable, dawniej anon). Publiczny z założenia; dane chroni RLS.
VITE_SUPABASE_PUBLISHABLE_KEY=
